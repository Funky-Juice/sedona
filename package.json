{
  "name": "sedona",
  "version": "0.1.0",
  "private": true,
  "description": "Личный проект «Седона» от HTML Academy",
  "author": "Сергей Иншаков",
  "devDependencies": {
    "@htmlacademy/editorconfig-cli": "3.0.0",
    "autoprefixer": "10.6.1",
    "browser-sync": "2.29.3",
    "css-mqpacker": "7.0.0",
    "grunt": "1.6.3",
    "grunt-browser-sync": "2.2.0",
    "grunt-contrib-clean": "2.0.1",
    "grunt-contrib-copy": "1.0.0",
    "grunt-contrib-imagemin": "4.0.0",
    "grunt-contrib-less": "3.0.0",
    "grunt-contrib-watch": "1.1.0",
    "grunt-csso": "2.2.4",
    "grunt-postcss": "0.9.0",
    "load-grunt-tasks": "5.1.0",
    "postcss": "8.5.29"
  },
  "scripts": {
    "test": "editorconfig-cli",
    "build": "grunt build",
    "start": "npm run build && grunt serve"
  },
  "editorconfig-cli": [
    "*.html",
    "*.json",
    "*.js",
    "js/**/*.js",
    "img/**/*.svg",
    "less/**/*.less"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "grunt-postcss": {
      "postcss": "$postcss"
    }
  },
  "allowScripts": {
    "gifsicle": true,
    "jpegtran-bin": true,
    "optipng-bin": true
  }
}
